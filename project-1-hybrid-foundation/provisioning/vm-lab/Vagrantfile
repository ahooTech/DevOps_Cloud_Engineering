Vagrant.configure("2") do |config|
  config.vm.box_check_update = false
  config.vm.boot_timeout = 3600
  config.ssh.insert_key = true

  # =====================================================
  # DEFAULT VIRTUALBOX SETTINGS (Linux VMs only)
  # =====================================================
  config.vm.provider "virtualbox" do |vb|
    vb.memory = "2048"
    vb.cpus = 2
    vb.gui = true
    vb.customize ["modifyvm", :id, "--uart1", "off"]
    vb.customize ["modifyvm", :id, "--uart2", "off"]
  end

  # =====================================================
  # UBUNTU SERVER
  # =====================================================
  config.vm.define "ubuntu-hardened" do |node|
    node.vm.box = "ubuntu/jammy64"
    node.vm.hostname = "proj1-ubuntu-hardened"

    # Share virtualization artifacts into the VM
    node.vm.synced_folder("C:/devops/project-1-hybrid-foundation/virtualization", "/virtualization")
    
    node.vm.network "private_network", ip: "10.10.1.10", virtualbox__intnet: "project1_hybrid", netmask: "255.255.0.0"

    node.vm.provider "virtualbox" do |vb|
      vb.name = "proj1-ubuntu-hardened"
    end

    # -----------------------------------------------------
    # Run the complete Linux configuration
    # -----------------------------------------------------
    node.vm.provision "ansible_local" do |ansible|
      ansible.playbook = "ansible/playbooks/linux-site.yml"
      ansible.install = true
      ansible.compatibility_mode = "2.0"
    end
  end

  # =====================================================
  # RHEL / ALMALINUX
  # =====================================================
  config.vm.define "rhel-hardened" do |node|
    node.vm.box = "almalinux/9"
    node.vm.hostname = "proj1-rhel-hardened"

    # Share virtualization artifacts into the VM
    node.vm.synced_folder("C:/devops/project-1-hybrid-foundation/virtualization", "/virtualization")
    
    node.ssh.username = "vagrant"
    node.vm.network "private_network", ip: "10.10.4.10", virtualbox__intnet: "project1_hybrid", netmask: "255.255.0.0"

    node.vm.provider "virtualbox" do |vb|
      vb.name = "proj1-rhel-hardened"
    end

    # Install Ansible first
    node.vm.provision "shell", path: "scripts/install-ansible-rhel.sh"

    # -----------------------------------------------------
    # Run the complete Linux configuration
    # -----------------------------------------------------
    node.vm.provision "ansible_local" do |ansible|
      ansible.playbook = "ansible/playbooks/linux-site.yml"
      ansible.install = false
      ansible.compatibility_mode = "2.0"
    end
  end



  # =====================================================
  # WINDOWS SERVER 2019 (VMware)
  # =====================================================
  config.vm.define "windows2019-hardened" do |node|
    node.vm.box = "gusztavvargadr/windows-server-2019-standard"

    # Alternative boxes
    # node.vm.box = "StefanScherer/windows_2019"
    # node.vm.box = "peru/windows-server-2019-standard"

    node.vm.hostname = "proj1-windows2019-hardened"

    # Windows takes longer to boot
    node.vm.boot_timeout = 900
    
    # WinRM communicator
    node.vm.communicator = "winrm"
    node.winrm.username = "vagrant"
    node.winrm.password = "vagrant"

    # 2. CRITICAL: Tell Vagrant to keep retrying WinRM instead of giving up
    node.winrm.retry_limit = 30
    node.winrm.retry_delay = 10

    # Bridged networking
    node.vm.network "public_network", bridge: "Wi-Fi"

    node.vm.provider "vmware_desktop" do |v|
      v.gui = true
      v.vmx["displayName"] = "proj1-windows2019-hardened"
      v.vmx["memsize"] = "4096"
      v.vmx["numvcpus"] = "2"
    end


    # -----------------------------------------------------
    # Windows is managed manually from WSL using:
    #
    # ansible-playbook -i ansible/inventory.ini \
    #   ansible/playbooks/windows-site.yml
    #
    # Run windows-finalize-winrm.yml only once after the
    # initial Windows configuration.

    # Reset network powershell as administartor:  netsh int ip reset; netsh winsock reset

    # -----------------------------------------------------

  end
end
